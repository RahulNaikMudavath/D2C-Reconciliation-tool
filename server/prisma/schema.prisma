generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FINANCE_EXECUTIVE
  CO_FOUNDER
}

enum ImportType {
  ORDERS
  SETTLEMENTS
  COD
  FREIGHT
  RETURNS
  WAREHOUSE_RECEIPTS
}

enum ImportStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum ClaimStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ReconciliationStatus {
  SETTLED
  SHORT_PAID
  UNPAID_PAST_DUE
  FREIGHT_OVERCHARGED
  RETURN_NOT_RECEIVED
  REVIEW_REQUIRED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(FINANCE_EXECUTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  imports      ImportBatch[]
  assignedClaims Claim[] @relation("ClaimOwner")
  auditLogs    AuditLog[]
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  type      String
  createdAt DateTime @default(now())

  rateCards RateCard[]
  claims    Claim[]
}

model ImportBatch {
  id          String       @id @default(uuid())
  fileName    String
  importType  ImportType
  status      ImportStatus @default(UPLOADED)
  rowCount    Int           @default(0)
  uploadedAt  DateTime      @default(now())

  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  sourceRecords SourceRecord[]
  mappings      ColumnMapping[]

  @@index([importType, status])
}

model SourceRecord {
  id            String      @id @default(uuid())
  rowNumber     Int
  rawData       Json
  normalizedData Json?
  processed     Boolean     @default(false)
  importBatchId String

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId, rowNumber])
}

model ColumnMapping {
  id            String   @id @default(uuid())
  sourceName    String
  version       Int
  mapping       Json
  approved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([sourceName, version])
}

model Order {
  id           String   @id @default(uuid())
  orderNumber  String   @unique
  channel      String
  orderDate    DateTime
  paymentMode  String
  deliveryStatus String
  expectedAmount Decimal @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  settlements Settlement[]
  freightCharges FreightCharge[]
  returns     ReturnRecord[]
  matches     ReconciliationMatch[]

  @@index([orderDate, channel])
}

model Settlement {
  id             String   @id @default(uuid())
  orderId        String
  partnerId      String?
  amountReceived Decimal  @db.Decimal(14, 2)
  tcsAmount      Decimal  @default(0) @db.Decimal(14, 2)
  tdsAmount      Decimal  @default(0) @db.Decimal(14, 2)
  settlementDate DateTime

  order   Order    @relation(fields: [orderId], references: [id])
  matches ReconciliationMatch[]
}

model RateCard {
  id             String   @id @default(uuid())
  channel        String
  courierName    String?
  baseCharge     Decimal  @db.Decimal(10, 2)
  perKgCharge    Decimal  @default(0) @db.Decimal(10, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  partnerId      String

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([channel, courierName, effectiveFrom])
}

model FreightCharge {
  id             String   @id @default(uuid())
  orderId        String
  courierName    String
  chargedAmount  Decimal  @db.Decimal(14, 2)
  actualWeight   Decimal? @db.Decimal(10, 3)
  createdAt      DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id])
  matches ReconciliationMatch[]
}

model ReturnRecord {
  id             String   @id @default(uuid())
  orderId        String
  returnDate     DateTime
  status         String
  warehouseReceivedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])
  matches ReconciliationMatch[]
}

model ReconciliationRun {
  id          String   @id @default(uuid())
  startedAt   DateTime @default(now())
  completedAt DateTime?
  status      String

  matches ReconciliationMatch[]
}

model ReconciliationMatch {
  id              String   @id @default(uuid())
  runId           String
  orderId         String
  settlementId    String?
  freightChargeId String?
  returnRecordId  String?
  status          ReconciliationStatus
  expectedAmount  Decimal  @db.Decimal(14, 2)
  actualAmount    Decimal  @db.Decimal(14, 2)
  difference      Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  run           ReconciliationRun @relation(fields: [runId], references: [id])
  order         Order @relation(fields: [orderId], references: [id])
  settlement    Settlement? @relation(fields: [settlementId], references: [id])
  freightCharge FreightCharge? @relation(fields: [freightChargeId], references: [id])
  returnRecord  ReturnRecord? @relation(fields: [returnRecordId], references: [id])

  @@index([status, orderId])
}

model Claim {
  id             String      @id @default(uuid())
  claimNumber    String      @unique
  description    String
  amount         Decimal     @db.Decimal(14, 2)
  status         ClaimStatus @default(OPEN)
  evidence       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  partnerId      String
  ownerId        String?

  partner Partner @relation(fields: [partnerId], references: [id])
  owner   User?   @relation("ClaimOwner", fields: [ownerId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
