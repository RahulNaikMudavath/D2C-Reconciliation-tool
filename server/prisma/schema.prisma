generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FINANCE_EXECUTIVE
  CO_FOUNDER
}

enum ImportType {
  ORDERS
  SETTLEMENTS
  COD
  FREIGHT
  RETURNS
  WAREHOUSE_RECEIPTS
}

enum ImportStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum ClaimStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ReconciliationStatus {
  SETTLED
  SHORT_PAID
  UNPAID_PAST_DUE
  FREIGHT_OVERCHARGED
  RETURN_NOT_RECEIVED
  REVIEW_REQUIRED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(FINANCE_EXECUTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  imports        ImportBatch[]
  assignedClaims Claim[]       @relation("ClaimOwner")
  auditLogs      AuditLog[]
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  type      String
  createdAt DateTime @default(now())

  rateCards        RateCard[]
  channelRateCards ChannelRateCard[]
  claims           Claim[]
  orders           Order[]
  settlements      Settlement[]
}

model ImportBatch {
  id         String       @id @default(uuid())
  fileName   String
  importType ImportType
  status     ImportStatus @default(UPLOADED)
  rowCount   Int          @default(0)
  uploadedAt DateTime     @default(now())

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  sourceRecords SourceRecord[]
  mappings      ColumnMapping[]
  settlements   Settlement[]

  @@index([importType, status])
}

model SourceRecord {
  id             String  @id @default(uuid())
  rowNumber      Int
  rawData        Json
  normalizedData Json?
  processed      Boolean @default(false)
  importBatchId  String

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId, rowNumber])
}

model ColumnMapping {
  id         String   @id @default(uuid())
  sourceName String
  version    Int
  mapping    Json
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([sourceName, version])
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique
  channel     String

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  orderDate      DateTime
  paymentMode    String
  deliveryStatus String

  // Original customer order value
  orderValue Decimal @db.Decimal(14, 2)

  // Expected net settlement calculated using channel rate card
  expectedSettlementAmount Decimal? @db.Decimal(14, 2)

  // When payment/remittance is expected
  settlementDueAt DateTime?

  // Used for expected courier charge calculation
  weightKg Decimal? @db.Decimal(10, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlements    Settlement[]
  freightCharges FreightCharge[]
  returns        ReturnRecord[]
  matches        ReconciliationMatch[]

  @@index([orderDate, channel])
  @@index([settlementDueAt])
  @@index([paymentMode, deliveryStatus])
}

model Settlement {
  id        String  @id @default(uuid())
  orderId   String
  partnerId String?

  // Amount reported before deductions, when available
  grossAmount Decimal? @db.Decimal(14, 2)

  // Actual money credited to the business
  amountReceived Decimal @db.Decimal(14, 2)

  // Deductions recorded separately
  commissionAmount Decimal @default(0) @db.Decimal(14, 2)
  otherFeeAmount   Decimal @default(0) @db.Decimal(14, 2)

  // Tax deductions: never classify these as leakage
  tcsAmount Decimal @default(0) @db.Decimal(14, 2)
  tdsAmount Decimal @default(0) @db.Decimal(14, 2)

  settlementDate  DateTime
  referenceNumber String?

  order            Order             @relation(fields: [orderId], references: [id])
  partner          Partner?          @relation(fields: [partnerId], references: [id])
  matchSettlements MatchSettlement[]

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@unique([partnerId, referenceNumber])
  @@index([orderId])
  @@index([settlementDate])
  @@index([importBatchId])
}

model RateCard {
  id          String @id @default(uuid())
  channel     String
  courierName String

  // Applicable weight slab
  minWeightKg Decimal  @default(0) @db.Decimal(10, 3)
  maxWeightKg Decimal? @db.Decimal(10, 3)

  baseCharge  Decimal @db.Decimal(10, 2)
  perKgCharge Decimal @default(0) @db.Decimal(10, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  @@index([channel, courierName, effectiveFrom])
  @@index([partnerId])
}

model ChannelRateCard {
  id      String @id @default(uuid())
  channel String

  // Marketplace/platform deductions
  commissionPercent Decimal @default(0) @db.Decimal(7, 4)
  fixedFee          Decimal @default(0) @db.Decimal(10, 2)
  otherFee          Decimal @default(0) @db.Decimal(10, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  @@index([channel, effectiveFrom])
  @@index([partnerId])
}

model FreightCharge {
  id            String   @id @default(uuid())
  orderId       String
  courierName   String
  chargedAmount Decimal  @db.Decimal(14, 2)
  actualWeight  Decimal? @db.Decimal(10, 3)
  invoiceNumber String?
  chargedAt     DateTime @default(now())

  order   Order                 @relation(fields: [orderId], references: [id])
  matches ReconciliationMatch[]

  @@index([orderId])
  @@index([chargedAt])
}

model ReturnRecord {
  id                  String    @id @default(uuid())
  orderId             String
  returnDate          DateTime
  status              String
  warehouseReceivedAt DateTime?

  order   Order                 @relation(fields: [orderId], references: [id])
  matches ReconciliationMatch[]
}

model ReconciliationRun {
  id          String    @id @default(uuid())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String

  matches ReconciliationMatch[]
}

model ReconciliationMatch {
  id              String               @id @default(uuid())
  runId           String
  orderId         String
  freightChargeId String?
  returnRecordId  String?
  status          ReconciliationStatus
  expectedAmount Decimal? @db.Decimal(14, 2)
  actualAmount   Decimal? @db.Decimal(14, 2)
  difference     Decimal? @db.Decimal(14, 2)
  reviewReason String?
  createdAt       DateTime             @default(now())

  run           ReconciliationRun @relation(fields: [runId], references: [id])
  order         Order             @relation(fields: [orderId], references: [id])
  settlements   MatchSettlement[]
  freightCharge FreightCharge?    @relation(fields: [freightChargeId], references: [id])
  returnRecord  ReturnRecord?     @relation(fields: [returnRecordId], references: [id])
  claims        Claim[]

  @@unique([runId, orderId])
  @@index([status, orderId])
}

model MatchSettlement {
  id                    String @id @default(uuid())
  reconciliationMatchId String
  settlementId          String

  reconciliationMatch ReconciliationMatch @relation(fields: [reconciliationMatchId], references: [id], onDelete: Cascade)
  settlement          Settlement          @relation(fields: [settlementId], references: [id])

  @@unique([reconciliationMatchId, settlementId])
  @@index([settlementId])
}

model Claim {
  id          String      @id @default(uuid())
  claimNumber String      @unique
  description String
  amount      Decimal     @db.Decimal(14, 2)
  status      ClaimStatus @default(OPEN)
  evidence    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  partnerId String
  ownerId   String?
  matchId   String?

  partner Partner              @relation(fields: [partnerId], references: [id])
  owner   User?                @relation("ClaimOwner", fields: [ownerId], references: [id])
  match   ReconciliationMatch? @relation(fields: [matchId], references: [id])

  @@unique([matchId])
  @@index([status, createdAt])
  @@index([partnerId])
  @@index([ownerId])
  @@index([matchId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
